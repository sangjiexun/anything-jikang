          improvement: "增加问题引入、数据开场或情感共鸣",
          expectedImpact: "提高读者停留时间和完读率"
        },
        {
          section: "内容结构",
          currentIssue: "段落较长，信息密度过高",
          improvement: "适当分段，增加视觉停顿和互动元素",
          expectedImpact: "改善阅读体验和传播效果"
        }
      ],
      summary: "文章整体具备基础结构，建议重点优化标题吸引力、开头钩子强度和内容分段，以提高成为爆款视频的潜力。"
    }
  }
}

watch(analysisResult, (newVal) => {
  if (typeof window !== 'undefined') {
    if (newVal) {
      localStorage.setItem('article_comparison_result', JSON.stringify(newVal))
    } else {
      localStorage.removeItem('article_comparison_result')
    }
  }
}, { deep: true })

watch(tocResult, (newVal) => {
  if (typeof window !== 'undefined') {
    if (newVal) {
      localStorage.setItem('article_toc_result', JSON.stringify(newVal))
    } else {
      localStorage.removeItem('article_toc_result')
    }
  }
}, { deep: true })

watch(highlightedContent, (newVal) => {
  if (typeof window !== 'undefined') {
    localStorage.setItem('article_highlights', JSON.stringify(newVal))
  }
}, { deep: true })

const emit = defineEmits<{
  (e: 'analysis-complete', result: any, content: { left: string, right: string }): void
}>()

const generateHighlights = (content: string, annotations: any[]) => {
  if (!annotations || annotations.length === 0) return content
  
  let highlightedContent = content
  annotations.forEach((annotation, index) => {
    if (annotation.paragraph) {
      const regex = new RegExp(annotation.paragraph.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi')
      const tooltipContent = encodeURIComponent(annotation.analysis || '')
      const annotationType = annotation.type || 'improvement'
      
      highlightedContent = highlightedContent.replace(regex, 
        `<span class="highlighted-annotation" data-tooltip="${tooltipContent}" data-index="${index}" data-type="${annotationType}">${annotation.paragraph}</span>`
      )
    }
  })
  return highlightedContent
}

// Generate cache key based on content and request type
const generateCacheKey = (type: 'analysis' | 'toc', left: string, right: string): string => {
  const content = `${type}:${left.slice(0, 100)}:${right.slice(0, 100)}`
  return btoa(content).replace(/[^a-zA-Z0-9]/g, '')
}

// Check cache for existing results
const checkCache = (type: 'analysis' | 'toc', left: string, right: string) => {
  const key = generateCacheKey(type, left, right)
  const cached = requestCache.value.get(key)
  if (cached && Date.now() - cached.timestamp < CACHE_DURATION) {
    return cached.data
  }
  return null
}

// Store results in cache
const storeInCache = (type: 'analysis' | 'toc', left: string, right: string, data: any) => {
  const key = generateCacheKey(type, left, right)
  requestCache.value.set(key, { data, timestamp: Date.now() })
}

// Throttled API request function
const throttledApiRequest = async (type: 'analysis' | 'toc', prompt: string, systemContent: string) => {
  const now = Date.now()
  const timeSinceLastRequest = now - lastRequestTime.value
  
  // Throttle requests
  if (timeSinceLastRequest < REQUEST_THROTTLE) {
    const waitTime = REQUEST_THROTTLE - timeSinceLastRequest
    console.log(`请求被限流，等待 ${waitTime}ms`)
    await new Promise(resolve => setTimeout(resolve, waitTime))
  }
  
  lastRequestTime.value = Date.now()
  
  const api = useApi()
  const resData = await api.post('chat/completions', {
    model: "qwen3-max",
    messages: [
      {
        role: 'system',
        content: systemContent
      },
      {
        role: 'user',
        content: prompt
      }
    ],
    temperature: 0.3
  })
  
  return resData
}

const analyzeArticles = async () => {
  if (!leftContent.value && !rightContent.value) {
    alert('请至少输入一篇文章内容')
    return
  }

  // Check if already analyzing
  if (isAnalyzing.value) {
    console.log('分析正在进行中，请稍候')
    return
  }

  // Check cache first
  const cachedResult = checkCache('analysis', leftContent.value, rightContent.value)
  if (cachedResult) {
    console.log('使用缓存的分析结果')
    analysisResult.value = cachedResult
    return
  }

  isAnalyzing.value = true
  
