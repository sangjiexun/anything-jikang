          type: "improvement",
          target: "left"
        },
        {
          paragraph: "开头部分",
          analysis: "文章B开头更有感染力，能够快速抓住读者注意力",
          suggestions: ["增加问题引入", "使用更生动的描述"],
          type: "improvement",
          target: "left"
        }
      ],
      strengths: [
        "文章A逻辑清晰，结构完整",
        "文章B标题吸引力强，具有爆款潜力",
        "两篇文章都提供了有价值的信息"
      ],
      weaknesses: [
        "文章A标题缺乏吸引力",
        "文章B某些表达可能过于夸张",
        "内容深度有待提升"
      ],
      summary: "文章A和文章B各有特色，建议融合文章B的标题策略和文章A的内容结构，创造出既有吸引力又有深度的爆款内容。"
    }
  } else {
    return {
      structureScore: 75,
      tocQuality: "中等",
      hierarchyAnalysis: [
        "文章结构基本清晰，但层次感有待加强",
        "建议增加小标题来更好地划分内容段落",
        "开头钩子部分需要强化"
      ],
      readabilityIssues: [
        "部分段落较长，建议适当分段提高可读性",
        "可增加过渡句来提升逻辑连贯性",
        "某些专业术语需要更多解释"
      ],
      specificImprovements: [
        {
          section: "标题优化",
